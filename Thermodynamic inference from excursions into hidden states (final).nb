Cell[CellGroupData[{

Cell["Benchmarks", "Subsection",ExpressionUUID->"b0a3c5fe-a029-432c-acb9-8b28f79310d6"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"Ncount", ",", " ", "Tdw", ",", " ", "Wnaive"}], "}"}], " ", "=", 
   " ", 
   RowBox[{"countJumps", "[", 
    RowBox[{"traj", ",", " ", "Ttot"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", "\"\<jump counts N[[to, from]]:\>\"", "]"}], ";", " ", 
  RowBox[{"Print", "[", 
   RowBox[{"MatrixForm", "[", "Ncount", "]"}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{
   "\"\<dwell times (s) = \>\"", ",", " ", "Tdw", ",", " ", 
    "\"\<,  occupations = \>\"", ",", " ", 
    RowBox[{"Tdw", "/", 
     RowBox[{"Total", "[", "Tdw", "]"}]}]}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", "\"\<naive W[[to, from]] (1/s):\>\"", "]"}], ";", " ", 
  RowBox[{"Print", "[", 
   RowBox[{"MatrixForm", "[", 
    RowBox[{"Chop", "[", "Wnaive", "]"}], "]"}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"affNaive", " ", "=", " ", 
   RowBox[{"affMax", "[", 
    RowBox[{"Wnaive", ",", " ", 
     RowBox[{"cfg", "[", "\"\<obsCD\>\"", "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"sigmaNaive", " ", "=", " ", 
   RowBox[{"EPR", "[", "Wnaive", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<naive benchmark: A_max(+1) for \>\"", ",", " ", 
    RowBox[{"cfg", "[", "\"\<obsCD\>\"", "]"}], ",", " ", "\"\< = \>\"", ",", 
    " ", "affNaive", ",", " ", "\"\<,  sigma = \>\"", ",", " ", "sigmaNaive", 
    ",", " ", "\"\< /s\>\""}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"ListQ", "[", 
      RowBox[{"cfg", "[", "\"\<bandEdge\>\"", "]"}], "]"}], ",", "\n", "  ", 
     RowBox[{
      RowBox[{"affBand", " ", "=", " ", 
       RowBox[{"rateBand", "[", 
        RowBox[{"Wnaive", ",", " ", "Ncount", ",", " ", "Tdw", ",", " ", 
         RowBox[{"cfg", "[", "\"\<bandEdge\>\"", "]"}], ",", " ", 
         RowBox[{
          RowBox[{"affMax", "[", 
           RowBox[{"#", ",", " ", 
            RowBox[{"cfg", "[", "\"\<obsCD\>\"", "]"}]}], "]"}], " ", "&"}]}],
         "]"}]}], ";", "\n", "  ", 
      RowBox[{"sigmaBand", " ", "=", " ", 
       RowBox[{"rateBand", "[", 
        RowBox[{"Wnaive", ",", " ", "Ncount", ",", " ", "Tdw", ",", " ", 
         RowBox[{"cfg", "[", "\"\<bandEdge\>\"", "]"}], ",", " ", "EPR"}], 
        "]"}]}], ";", "\n", "  ", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<band from the count on edge \>\"", ",", " ", 
        RowBox[{"cfg", "[", "\"\<bandEdge\>\"", "]"}], ",", " ", 
        "\"\<:  A_max(+1) in \>\"", ",", " ", "affBand", ",", " ", 
        "\"\<,  sigma in \>\"", ",", " ", "sigmaBand"}], "]"}]}]}], "]"}], 
   ";"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "if", " ", "the", " ", "rare", " ", "reverse", " ", "edge", " ", "was", 
     " ", "never", " ", "recorded"}], ",", " ", 
    RowBox[{
    "the", " ", "naive", " ", "W", " ", "has", " ", "a", " ", "zero", " ", 
     "rate", " ", 
     RowBox[{"there", ":", " ", 
      RowBox[{
       RowBox[{"A_max", 
        RowBox[{"(", 
         RowBox[{"+", "1"}], ")"}], " ", "is"}], " ", "-", 
       RowBox[{
       "Infinity", " ", "and", " ", "EPR", " ", "drops", " ", "the", "\n", 
        "   ", "edge"}]}]}]}], ",", " ", 
    RowBox[{
     RowBox[{
     "so", " ", "there", " ", "is", " ", "no", " ", "naive", " ", "point"}], 
     ";", " ", 
     RowBox[{"panels", " ", 
      RowBox[{"(", "c", ")"}]}]}], ",", " ", 
    RowBox[{
     RowBox[{"(", "d", ")"}], " ", "then", " ", "show", " ", "only", " ", 
     "the", " ", "band"}]}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"naiveOK", " ", "=", " ", 
    RowBox[{"!", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"ListQ", "[", 
        RowBox[{"cfg", "[", "\"\<bandEdge\>\"", "]"}], "]"}], " ", "&&", " ", 
       
       RowBox[{
        RowBox[{"Ncount", "[", 
         RowBox[{"[", 
          RowBox[{
           RowBox[{
            RowBox[{"cfg", "[", "\"\<bandEdge\>\"", "]"}], "[", 
            RowBox[{"[", "2", "]"}], "]"}], ",", " ", 
           RowBox[{
            RowBox[{"cfg", "[", "\"\<bandEdge\>\"", "]"}], "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], "]"}], "]"}], " ", "==", " ", 
        "0"}]}], ")"}]}]}], ";"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
   "contribution", " ", "of", " ", "each", " ", "edge", " ", "to", " ", "the",
     " ", "naive", " ", "entropy", " ", "production"}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"piN", " ", "=", " ", 
   RowBox[{"steadyState", "[", "Wnaive", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"edgeSigma", " ", "=", " ", 
   RowBox[{"Flatten", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"f", " ", "=", " ", 
            RowBox[{
             RowBox[{"Wnaive", "[", 
              RowBox[{"[", 
               RowBox[{"b", ",", " ", "a"}], "]"}], "]"}], " ", 
             RowBox[{"piN", "[", 
              RowBox[{"[", "a", "]"}], "]"}]}]}], ",", " ", 
           RowBox[{"r", " ", "=", " ", 
            RowBox[{
             RowBox[{"Wnaive", "[", 
              RowBox[{"[", 
               RowBox[{"a", ",", " ", "b"}], "]"}], "]"}], " ", 
             RowBox[{"piN", "[", 
              RowBox[{"[", "b", "]"}], "]"}]}]}]}], "}"}], ",", "\n", "     ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"a", ",", " ", "b"}], "}"}], ",", " ", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"f", " ", ">", " ", "0"}], " ", "&&", " ", 
              RowBox[{"r", " ", ">", " ", "0"}]}], ",", " ", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"f", " ", "-", " ", "r"}], ")"}], " ", 
              RowBox[{"Log", "[", 
               RowBox[{"f", "/", "r"}], "]"}]}], ",", " ", 
             RowBox[{"Missing", "[", "]"}]}], "]"}]}], "}"}]}], "]"}], ",", 
       " ", 
       RowBox[{"{", 
        RowBox[{"a", ",", " ", "4"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"b", ",", " ", 
         RowBox[{"a", " ", "+", " ", "1"}], ",", " ", "4"}], "}"}]}], "]"}], 
     ",", " ", "1"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"Grid", "[", 
    RowBox[{
     RowBox[{"Prepend", "[", 
      RowBox[{"edgeSigma", ",", " ", 
       RowBox[{"{", 
        RowBox[{
        "\"\<edge\>\"", ",", " ", "\"\<contribution to sigma (1/s)\>\""}], 
        "}"}]}], "]"}], ",", " ", 
     RowBox[{"Frame", " ", "->", " ", "All"}]}], "]"}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Print", "[", 
    RowBox[{
    "\"\<share of the naive sigma on the edges of the ring 1-2-3: \>\"", ",", 
     "\n", "  ", 
     RowBox[{
      RowBox[{"Total", "[", 
       RowBox[{"Cases", "[", 
        RowBox[{"edgeSigma", ",", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{"e_", ",", " ", 
             RowBox[{"v_", "?", "NumericQ"}]}], "}"}], " ", "/;", " ", 
           RowBox[{"SubsetQ", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}], ",", " ", 
             "e"}], "]"}]}], " ", ":>", " ", "v"}]}], "]"}], "]"}], "/", 
      "sigmaNaive"}]}], "]"}], ";"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "Table", " ", "I", " ", "of", " ", "the", " ", "Supplemental", " ", 
     RowBox[{"Material", ":", " ", 
      RowBox[{
       RowBox[{
       "the", " ", "seven", " ", "cycles", " ", "of", " ", "the", " ", 
        "four"}], "-", 
       RowBox[{"state", " ", "network"}]}]}]}], ",", " ", 
    RowBox[{
    "each", " ", "in", " ", "the", " ", "orientation", " ", "with", "\n", 
     "   ", "positive", " ", "affinity"}], ",", " ", 
    RowBox[{
    "and", " ", "the", " ", "outcome", " ", "q", " ", "of", " ", "the", " ", 
     "observable", " ", 
     RowBox[{"cfg", "[", "\"\<obsCD\>\"", "]"}], " ", "along", " ", "it"}]}], 
   " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"cycles7", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "3", ",", " ", "2", ",", " ", "1"}], "}"}], ",", 
     " ", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "4", ",", " ", "2", ",", " ", "1"}], "}"}], ",", 
     " ", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "4", ",", " ", "3", ",", " ", "1"}], "}"}], ",", 
     " ", 
     RowBox[{"{", 
      RowBox[{"2", ",", " ", "4", ",", " ", "3", ",", " ", "2"}], "}"}], ",", 
     " ", 
     RowBox[{"{", 
      RowBox[{
      "1", ",", " ", "2", ",", " ", "4", ",", " ", "3", ",", " ", "1"}], 
      "}"}], ",", " ", 
