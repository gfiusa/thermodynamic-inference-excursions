Cell[CellGroupData[{

Cell["\<\
fig = If[DownValues[grid] =!= {},
   grid[{edgeplot, diffplot, affplot, sigplot}, 1, {0.14, 0.92}, 22],
   GraphicsRow[{edgeplot, diffplot, affplot, sigplot,occTrace, occHistLin}, \
ImageSize -> 1100]];
figs[cfg[\"id\"]] = fig;
results[cfg[\"id\"]] = <|\"cfg\" -> cfg, \"traj\" -> traj, \"Ttot\" -> Ttot, \
\"W\" -> Wnaive, \"lnLo\" -> lnLo, \"sigLo\" -> sigLo, \"sweep\" -> sweep|>;
fig\
\>", "Input",
