              RowBox[{"y", ",", " ", 
               RowBox[{"{", "e", "}"}]}], "]"}], "]"}], "/", 
            RowBox[{"Length", "[", "y", "]"}]}]}], "]"}], "]"}]}]}], "]"}]}], 
    ";"}], "\n", 
