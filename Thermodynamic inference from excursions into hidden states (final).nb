Cell[CellGroupData[{

Cell["Statistics quoted in the text", "Subsection",ExpressionUUID->"b239e1ae-94df-4021-9858-f663f5b7cb79"],

Cell["\<\
Numbers quoted in the text: p-values of panels (a), (b), detection time, \
directedness of the visits to state 4, the excursion statistics predicted by \
the naive W, and the significance of the gap between estimators and benchmark.\
\>", "Text",ExpressionUUID->"19b7db57-150e-448d-8315-39fe1b2ede38"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"--", 
       RowBox[{"--", " ", 
        RowBox[{"(", "1", ")"}]}]}], " ", "p"}], "-", 
     RowBox[{"values", " ", "of", " ", "panels", " ", 
      RowBox[{"(", "a", ")"}], " ", "and", " ", 
      RowBox[{"(", "b", ")"}]}]}], ",", " ", 
    RowBox[{
     RowBox[{"observable", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"cfg", "[", "\"\<obsB\>\"", "]"}], " ", "--"}], "--"}], "\n", 
      "   ", 
      RowBox[{"(", "a", ")"}], " ", 
      RowBox[{"frequencies", ":", " ", 
       RowBox[{
        RowBox[{"exact", " ", "two"}], "-", 
        RowBox[{"sided", " ", "binomial", " ", "test", " ", "of", " ", "P", 
         RowBox[{"(", 
          RowBox[{"+", "1"}], ")"}]}]}]}]}], " ", "=", " ", 
     RowBox[{
      RowBox[{"P", 
       RowBox[{"(", 
        RowBox[{"-", "1"}], ")"}], " ", "given", " ", "n"}], " ", "=", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"n", 
         RowBox[{"(", 
          RowBox[{"+", "1"}], ")"}]}], " ", "+", " ", 
        RowBox[{"n", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"-", "1"}], ")"}], ".", "\n", "   ", 
          RowBox[{"(", "b", ")"}]}], " ", 
         RowBox[{"durations", ":", "   ", 
          RowBox[{"two", "-", 
           RowBox[{"sample", " ", "Kolmogorov"}], "-", 
           RowBox[{"Smirnov", " ", "test", " ", "of", " ", "P", 
            RowBox[{"(", 
             RowBox[{"t", "|", 
              RowBox[{"+", "1"}]}], ")"}]}]}]}]}]}], " ", "=", " ", 
       RowBox[{"P", 
        RowBox[{"(", 
         RowBox[{"t", "|", 
          RowBox[{"-", "1"}]}], ")"}]}]}]}]}], ",", " ", 
    RowBox[{
     RowBox[{"plus", " ", "a", " ", "permutation", " ", "p"}], "-", 
     RowBox[{"value", "\n", "                    ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"2", " ", "x", " ", 
         RowBox[{"10", "^", "4"}], " ", "shuffles", " ", "of", " ", "the", 
         " ", "labels"}], " ", "+", 
        RowBox[{
         RowBox[{"1", "/", 
          RowBox[{"-", "1"}]}], " ", "among", " ", "the", " ", "nonzero", " ",
          "excursions"}]}], ")"}]}]}], ",", " ", 
    RowBox[{
    "which", " ", "makes", " ", "no", " ", "assumption", " ", "on", " ", 
     RowBox[{"ties", "."}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"excS", " ", "=", " ", 
     RowBox[{"excursionsOut", "[", 
      RowBox[{"traj", ",", " ", "aState", ",", " ", 
       RowBox[{"nuOf", "[", 
        RowBox[{"cfg", "[", "\"\<obsB\>\"", "]"}], "]"}]}], "]"}]}], ";"}], 
   "\n", 
   RowBox[{
    RowBox[{"tPs", " ", "=", " ", 
     RowBox[{"Pick", "[", 
      RowBox[{
       RowBox[{"excS", "[", "\"\<duration\>\"", "]"}], ",", " ", 
       RowBox[{"excS", "[", "\"\<q\>\"", "]"}], ",", " ", "1"}], "]"}]}], ";",
     " ", 
    RowBox[{"tMs", " ", "=", " ", 
     RowBox[{"Pick", "[", 
      RowBox[{
       RowBox[{"excS", "[", "\"\<duration\>\"", "]"}], ",", " ", 
       RowBox[{"excS", "[", "\"\<q\>\"", "]"}], ",", " ", 
       RowBox[{"-", "1"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"exact", " ", "two"}], "-", 
      RowBox[{"sample", " ", "KS", " ", "distance"}]}], ",", " ", 
     RowBox[{
      RowBox[{
      "computed", " ", "on", " ", "the", " ", "union", " ", "of", " ", "the", 
       " ", "observed", " ", "values"}], ";", " ", 
      RowBox[{"fast", " ", "enough", " ", "for", " ", "2", " ", "x", " ", 
       RowBox[{"10", "^", "4"}], " ", "shuffles"}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"ksD", "[", 
      RowBox[{"x_", ",", " ", "y_"}], "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"e", " ", "=", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"Append", "[", 
            RowBox[{"#", ",", " ", 
             RowBox[{
              RowBox[{"Last", "[", "#", "]"}], " ", "+", " ", "1"}]}], "]"}], 
           " ", "&"}], "[", 
          RowBox[{"Union", "[", 
           RowBox[{"Join", "[", 
            RowBox[{"x", ",", " ", "y"}], "]"}], "]"}], "]"}]}], "}"}], ",", 
       "\n", "   ", 
       RowBox[{"N", "@", 
        RowBox[{"Max", "[", 
         RowBox[{"Abs", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Accumulate", "[", 
             RowBox[{"BinCounts", "[", 
              RowBox[{"x", ",", " ", 
               RowBox[{"{", "e", "}"}]}], "]"}], "]"}], "/", 
            RowBox[{"Length", "[", "x", "]"}]}], " ", "-", " ", 
           RowBox[{
            RowBox[{"Accumulate", "[", 
