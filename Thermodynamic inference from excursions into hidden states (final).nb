Cell["Markov tools", "Subsection",ExpressionUUID->"c75d04d7-06ed-4c39-b108-d54f26bc9823"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"--", 
      RowBox[{"--", " ", "Markov"}]}], " ", 
     RowBox[{"tools", ".", " ", 
      RowBox[{"W", "[", 
       RowBox[{"[", 
        RowBox[{"to", ",", " ", "from"}], "]"}], "]"}]}]}], ";", " ", 
    RowBox[{
    "the", " ", "diagonal", " ", "of", " ", "W", " ", "is", " ", "never", " ", 
     RowBox[{
      RowBox[{"used", " ", "--"}], "--"}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"offDiag", "[", "W_", "]"}], " ", ":=", " ", 
     RowBox[{"W", " ", "-", " ", 
      RowBox[{"DiagonalMatrix", "[", 
       RowBox[{"Diagonal", "[", "W", "]"}], "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"generator", "[", "W_", "]"}], " ", ":=", " ", 
     RowBox[{
      RowBox[{"offDiag", "[", "W", "]"}], " ", "-", " ", 
      RowBox[{"DiagonalMatrix", "[", 
       RowBox[{"Total", "[", 
        RowBox[{"offDiag", "[", "W", "]"}], "]"}], "]"}]}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"stationary", " ", 
      RowBox[{"distribution", ":", " ", 
       RowBox[{"generator", " ", ".", " ", "p"}]}]}], " ", "=", " ", 
     RowBox[{
     "0", " ", "with", " ", "one", " ", "equation", " ", "replaced", " ", 
      "by", " ", "the", " ", "normalisation"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"steadyState", "[", "W_", "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"G", " ", "=", " ", 
          RowBox[{"generator", "[", 
