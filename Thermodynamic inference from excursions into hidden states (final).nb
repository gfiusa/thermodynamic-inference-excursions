Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"(", "b", ")"}], " ", "F"}], "+", 
     RowBox[{"(", "t", ")"}], " ", "-", " ", "F", "-", 
     RowBox[{
      RowBox[{"(", "t", ")"}], " ", "of", " ", "the", " ", "excursion", " ", 
      "durations", " ", "for", " ", 
      RowBox[{"cfg", "[", "\"\<obsB\>\"", "]"}]}]}], ",", " ", 
    RowBox[{
     RowBox[{"bootstrap", " ", "band"}], ";", " ", 
     RowBox[{"x", " ", "=", " ", 
      RowBox[{
       RowBox[{"t", "/", "tmaxB"}], " ", 
       RowBox[{"(", 
        RowBox[{
        "98", "%", " ", "quantile", " ", "of", " ", "the", " ", "durations"}],
         ")"}]}]}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"excB", " ", "=", " ", 
     RowBox[{"excursionsOut", "[", 
      RowBox[{"traj", ",", " ", "aState", ",", " ", 
       RowBox[{"nuOf", "[", 
        RowBox[{"cfg", "[", "\"\<obsB\>\"", "]"}], "]"}]}], "]"}]}], ";"}], 
   "\n", 
   RowBox[{
    RowBox[{"tauPlus", " ", "=", " ", 
     RowBox[{"Pick", "[", 
      RowBox[{
       RowBox[{"excB", "[", "\"\<duration\>\"", "]"}], ",", " ", 
       RowBox[{"excB", "[", "\"\<q\>\"", "]"}], ",", " ", "1"}], "]"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"tauMinus", " ", "=", " ", 
     RowBox[{"Pick", "[", 
      RowBox[{
       RowBox[{"excB", "[", "\"\<duration\>\"", "]"}], ",", " ", 
       RowBox[{"excB", "[", "\"\<q\>\"", "]"}], ",", " ", 
       RowBox[{"-", "1"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"tmaxB", " ", "=", " ", 
     RowBox[{"Quantile", "[", 
      RowBox[{
       RowBox[{"Join", "[", 
        RowBox[{"tauPlus", ",", " ", "tauMinus"}], "]"}], ",", " ", "0.98"}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"gridB", " ", "=", " ", 
     RowBox[{"Subdivide", "[", 
      RowBox[{"0.", ",", " ", 
       RowBox[{"N", "@", "tmaxB"}], ",", " ", "80"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"diffB", " ", "=", " ", 
     RowBox[{
      RowBox[{"CDF", "[", 
       RowBox[{
        RowBox[{"EmpiricalDistribution", "[", "tauPlus", "]"}], ",", " ", 
        "gridB"}], "]"}], " ", "-", " ", 
      RowBox[{"CDF", "[", 
       RowBox[{
        RowBox[{"EmpiricalDistribution", "[", "tauMinus", "]"}], ",", " ", 
        "gridB"}], "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"SeedRandom", "[", "3", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"matB", " ", "=", " ", 
     RowBox[{"Transpose", "@", 
      RowBox[{"Table", "[", "\n", "    ", 
       RowBox[{
        RowBox[{
         RowBox[{"CDF", "[", 
          RowBox[{
           RowBox[{"EmpiricalDistribution", "[", 
            RowBox[{"RandomChoice", "[", 
             RowBox[{"tauPlus", ",", " ", 
              RowBox[{"Length", "[", "tauPlus", "]"}]}], "]"}], "]"}], ",", 
           " ", "gridB"}], "]"}], " ", "-", "\n", "     ", 
         RowBox[{"CDF", "[", 
          RowBox[{
           RowBox[{"EmpiricalDistribution", "[", 
            RowBox[{"RandomChoice", "[", 
             RowBox[{"tauMinus", ",", " ", 
              RowBox[{"Length", "[", "tauMinus", "]"}]}], "]"}], "]"}], ",", 
           " ", "gridB"}], "]"}]}], ",", " ", 
        RowBox[{"{", "1000", "}"}]}], "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"loB", " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"Quantile", "[", 
        RowBox[{"#", ",", " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1", " ", "-", " ", "cl"}], ")"}], "/", "2"}]}], "]"}], 
       " ", "&"}], " ", "/@", " ", "matB"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"hiB", " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"Quantile", "[", 
        RowBox[{"#", ",", " ", 
         RowBox[{"1", " ", "-", " ", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"1", " ", "-", " ", "cl"}], ")"}], "/", "2"}]}]}], "]"}], 
       " ", "&"}], " ", "/@", " ", "matB"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<durations for \>\"", ",", " ", 
      RowBox[{"cfg", "[", "\"\<obsB\>\"", "]"}], ",", " ", 
      "\"\<: n(+1) = \>\"", ",", " ", 
      RowBox[{"Length", "[", "tauPlus", "]"}], ",", " ", "\"\<, n(-1) = \>\"",
       ",", " ", 
      RowBox[{"Length", "[", "tauMinus", "]"}], ",", " ", 
      "\"\<,  KS p = \>\"", ",", " ", 
      RowBox[{"KolmogorovSmirnovTest", "[", 
       RowBox[{"tauPlus", ",", " ", "tauMinus", ",", " ", "\"\<PValue\>\""}], 
       "]"}]}], "]"}], ";"}], "\n", 
   RowBox[{"diffplot", " ", "=", " ", 
    RowBox[{"Show", "[", "\n", "  ", 
     RowBox[{
      RowBox[{"ListLinePlot", "[", 
       RowBox[{
        RowBox[{"staircase", "[", 
         RowBox[{
          RowBox[{"gridB", "/", "tmaxB"}], ",", " ", "diffB"}], "]"}], ",", 
        " ", 
        RowBox[{"PlotStyle", " ", "->", " ", "green"}], ",", " ", 
        RowBox[{"ImageSize", " ", "->", " ", "250"}], ",", " ", 
        RowBox[{"AspectRatio", " ", "->", " ", "1"}], ",", "\n", "   ", 
        RowBox[{"BaseStyle", " ", "->", " ", "baseStyle"}], ",", "\n", "   ", 
        
        RowBox[{"FrameLabel", " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"tex", "[", "\"\<t/T_{\\\\max}\>\"", "]"}], ",", " ", 
           RowBox[{"tex", "[", "\"\<F_{+}(t)-F_{-}(t)\>\"", "]"}]}], "}"}]}], 
        ",", "\n", "   ", 
        RowBox[{"PlotRange", " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", " ", "1.01"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "0.03"}], ",", " ", "0.13"}], "}"}]}], "}"}]}]}], 
       "]"}], ",", "\n", "  ", 
