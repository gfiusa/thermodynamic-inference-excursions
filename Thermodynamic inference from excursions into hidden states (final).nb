Cell["\<\
Numbers quoted in the text: p-values of panels (a), (b), detection time, \
directedness of the visits to state 4, the excursion statistics predicted by \
the naive W, and the significance of the gap between estimators and benchmark.\
\>", "Text",ExpressionUUID->"96ad5301-912d-405c-bb0a-ac4208e52199"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"--", 
       RowBox[{"--", " ", 
        RowBox[{"(", "1", ")"}]}]}], " ", "p"}], "-", 
     RowBox[{"values", " ", "of", " ", "panels", " ", 
      RowBox[{"(", "a", ")"}], " ", "and", " ", 
      RowBox[{"(", "b", ")"}]}]}], ",", " ", 
    RowBox[{
     RowBox[{"observable", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"cfg", "[", "\"\<obsB\>\"", "]"}], " ", "--"}], "--"}], "\n", 
      "   ", 
      RowBox[{"(", "a", ")"}], " ", 
      RowBox[{"frequencies", ":", " ", 
       RowBox[{
        RowBox[{"exact", " ", "two"}], "-", 
        RowBox[{"sided", " ", "binomial", " ", "test", " ", "of", " ", "P", 
         RowBox[{"(", 
          RowBox[{"+", "1"}], ")"}]}]}]}]}], " ", "=", " ", 
     RowBox[{
      RowBox[{"P", 
       RowBox[{"(", 
        RowBox[{"-", "1"}], ")"}], " ", "given", " ", "n"}], " ", "=", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"n", 
         RowBox[{"(", 
          RowBox[{"+", "1"}], ")"}]}], " ", "+", " ", 
        RowBox[{"n", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"-", "1"}], ")"}], ".", "\n", "   ", 
          RowBox[{"(", "b", ")"}]}], " ", 
         RowBox[{"durations", ":", "   ", 
          RowBox[{"two", "-", 
           RowBox[{"sample", " ", "Kolmogorov"}], "-", 
           RowBox[{"Smirnov", " ", "test", " ", "of", " ", "P", 
            RowBox[{"(", 
             RowBox[{"t", "|", 
              RowBox[{"+", "1"}]}], ")"}]}]}]}]}]}], " ", "=", " ", 
       RowBox[{"P", 
        RowBox[{"(", 
         RowBox[{"t", "|", 
          RowBox[{"-", "1"}]}], ")"}]}]}]}]}], ",", " ", 
    RowBox[{
     RowBox[{"plus", " ", "a", " ", "permutation", " ", "p"}], "-", 
     RowBox[{"value", "\n", "                    ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"2", " ", "x", " ", 
         RowBox[{"10", "^", "4"}], " ", "shuffles", " ", "of", " ", "the", 
         " ", "labels"}], " ", "+", 
        RowBox[{
         RowBox[{"1", "/", 
          RowBox[{"-", "1"}]}], " ", "among", " ", "the", " ", "nonzero", " ",
          "excursions"}]}], ")"}]}]}], ",", " ", 
    RowBox[{
    "which", " ", "makes", " ", "no", " ", "assumption", " ", "on", " ", 
     RowBox[{"ties", "."}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"excS", " ", "=", " ", 
     RowBox[{"excursionsOut", "[", 
      RowBox[{"traj", ",", " ", "aState", ",", " ", 
